<% content_for :title, "Update password - Roomies" %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h1 class="h3 fw-bold mb-4">Update your password</h1>

          <%= form_with url: password_path(params[:token]), method: :put do |form| %>
            <%= render "shared/form_errors", record: @user %>

            <div class="mb-3">
              <%= form.label :password, "New password", class: "form-label" %>
              <%= form.password_field :password, class: "form-control", required: true, autofocus: true,
                    autocomplete: "new-password", minlength: 8, maxlength: 72,
                    aria: { describedby: "password_help" } %>
              <div id="password_help" class="form-text">Use at least 8 characters.</div>
              <%= field_error @user, :password %>
            </div>
            <div class="mb-4">
              <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
              <%= form.password_field :password_confirmation, class: "form-control", required: true,
                    autocomplete: "new-password", minlength: 8, maxlength: 72 %>
              <%= field_error @user, :password_confirmation %>
            </div>
            <%= form.submit "Save password", class: "btn btn-primary w-100" %>
          <% end %>

          <p class="small mt-3 mb-0"><%= link_to "Back to log in", new_session_path %></p>
        </div>
      </div>
    </div>
  </div>
</div>
