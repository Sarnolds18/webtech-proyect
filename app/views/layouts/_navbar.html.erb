<header>
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm" aria-label="Main navigation">
    <div class="container">
      <%= link_to "Roomies", root_path, class: "navbar-brand fw-bold text-primary" %>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
              aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarMain">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
          <li class="nav-item">
            <%= nav_link_to "Search", listings_path %>
          </li>
          <li class="nav-item">
            <%= nav_link_to "Neighborhoods", neighborhoods_path %>
          </li>
          <li class="nav-item">
            <%= nav_link_to "Properties", properties_path %>
          </li>
          <% if current_user %>
            <li class="nav-item">
              <%= nav_link_to "My applications", applications_path %>
            </li>
          <% end %>
          <% if policy(Amenity).create? %>
            <li class="nav-item">
              <%= nav_link_to "Amenities", amenities_path %>
            </li>
          <% end %>
          <% if policy(Report).index? %>
            <li class="nav-item">
              <%= link_to reports_path, class: class_names("nav-link", active: request.path.start_with?(reports_path)),
                    aria: { current: ("page" if request.path.start_with?(reports_path)) } do %>
                Reports
                <% if (open_reports = Report.unresolved.count).positive? %>
                  <span class="badge rounded-pill text-bg-danger"><%= open_reports %><span class="visually-hidden"> open</span></span>
                <% end %>
              <% end %>
            </li>
          <% end %>
          <li class="nav-item">
            <%= link_to "Publish a Room", new_property_path, class: "nav-link" %>
          </li>
          <%= render "layouts/user_menu" %>
        </ul>
      </div>
    </div>
  </nav>
</header>
