<% content_for :title, "My applications - Roomies" %>

<div class="container py-4">
  <h1 class="fw-bold mb-2">My applications</h1>
  <p class="text-muted mb-4">
    <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>
    Only you and the host of each listing can see these applications.
  </p>

  <section class="mb-5" aria-labelledby="sent-heading">
    <h2 id="sent-heading" class="h4 fw-bold mb-3">
      Applications I sent <span class="badge text-bg-secondary align-middle fs-6"><%= @sent.size %></span>
    </h2>

    <% if @sent.present? %>
      <%= render "applications/table", applications: @sent, show_applicant: false %>
    <% else %>
      <p class="text-muted mb-0">
        You have not applied to any room yet. <%= link_to "Search rooms", listings_path %>.
      </p>
    <% end %>
  </section>

  <section class="mb-5" aria-labelledby="received-heading">
    <h2 id="received-heading" class="h4 fw-bold mb-3">
      Applications I received
      <span class="badge text-bg-secondary align-middle fs-6"><%= @received.values.sum(&:size) %></span>
    </h2>

    <% if @received.present? %>
      <% @received.each do |listing, applications| %>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-2">
          <h3 class="h5 fw-semibold mb-0">
            <%= link_to listing.title, listing_path(listing) %> <%= status_badge(listing.status) %>
          </h3>
          <%= link_to listing_inbox_path(listing), class: "btn btn-sm btn-outline-primary" do %>
            <i class="bi bi-inbox me-1" aria-hidden="true"></i>Open the inbox
          <% end %>
        </div>
        <%= render "applications/table", applications: applications, show_listing: false %>
      <% end %>
    <% else %>
      <p class="text-muted mb-0">Your listings have not received applications yet.</p>
    <% end %>
  </section>

  <% if @others.present? %>
    <section aria-labelledby="others-heading">
      <h2 id="others-heading" class="h4 fw-bold mb-1">
        Every other application <span class="badge text-bg-warning align-middle fs-6"><%= @others.size %></span>
      </h2>
      <p class="small text-muted mb-3">You can read these because you are a moderator. Only each host answers them.</p>
      <%= render "applications/table", applications: @others %>
    </section>
  <% end %>
</div>
