<%# The one place where the markup of a listing card lives. Render it inside a Bootstrap row. %>
<% neighborhood = listing.property.neighborhood %>
<div class="col">
  <article class="card h-100 shadow-sm overflow-hidden listing-card">
    <%= image_tag listing_photo(listing), class: "card-img-top", alt: "Room in #{neighborhood.name}" %>

    <div class="card-body d-flex flex-column p-4">
      <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill px-3 py-2 fw-semibold">
          <%= neighborhood.name %>
        </span>
        <span class="fw-bold text-success listing-card-price">
          <%= money(listing.monthly_rent) %> <small class="text-muted fw-normal">/ month</small>
        </span>
      </div>

      <h3 class="card-title h5 fw-bold mb-1">
        <%= link_to listing.title, listing_path(listing), class: "stretched-link text-decoration-none text-dark" %>
      </h3>
      <p class="card-text text-secondary small flex-grow-1"><%= listing.property.title %></p>

      <p class="pt-3 border-top mt-auto mb-0 small text-muted">
        <i class="bi bi-calendar-event me-1 text-primary" aria-hidden="true"></i>
        Available from <strong><%= listing.available_from.strftime("%B %-d, %Y") %></strong>
      </p>
    </div>
  </article>
</div>
