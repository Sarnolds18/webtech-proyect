<% content_for :title, "New listing - Roomies" %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <h1 class="fw-bold mb-1">New listing</h1>
      <p class="text-muted mb-4">
        In <%= link_to @property.title, property_path(@property) %>. It is saved as a draft that only you can
        see; publish it from its page when it is ready.
      </p>
      <%= render "form", listing: @listing %>
    </div>
  </div>
</div>
