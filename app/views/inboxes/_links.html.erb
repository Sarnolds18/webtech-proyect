<%# For the host on the property page: the inbox of each listing, with the applications waiting. %>
<% with_applications = listings.reject(&:draft?) %>
<% if with_applications.any? %>
  <div class="card shadow-sm mt-4">
    <div class="card-body p-4">
      <h3 class="h5 fw-bold mb-3">Applications received</h3>
      <ul class="list-group list-group-flush">
        <% with_applications.each do |listing| %>
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <%= link_to listing.title, listing_inbox_path(listing) %>
            <span class="badge text-bg-primary rounded-pill">
              <%= listing.applications.awaiting_answer.count %> waiting
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
