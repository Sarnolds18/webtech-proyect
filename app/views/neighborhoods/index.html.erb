<% content_for :title, "Neighborhoods - Roomies" %>

<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="fw-bold mb-0">Neighborhoods</h1>
    <% if current_user&.moderator? %>
      <%= link_to new_neighborhood_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New neighborhood
      <% end %>
    <% end %>
  </div>

  <h2 class="h5 text-muted mb-3"><%= pluralize(@neighborhoods.length, "neighborhood") %></h2>

  <% if @neighborhoods.present? %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
      <% @neighborhoods.each do |neighborhood| %>
        <div class="col">
          <article class="card h-100 shadow-sm">
            <div class="card-body p-4">
              <h3 class="card-title h5 fw-bold mb-1">
                <%= link_to neighborhood.name, neighborhood_path(neighborhood),
                      class: "stretched-link text-decoration-none text-dark" %>
              </h3>
              <p class="card-text text-secondary small mb-3"><%= neighborhood.city %></p>
              <p class="mb-0 small text-muted">
                <i class="bi bi-door-open me-1 text-primary" aria-hidden="true"></i>
                <%= pluralize(@published_counts.fetch(neighborhood.id, 0), "room") %> available
              </p>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mb-0">There are no neighborhoods in the catalog yet.</p>
  <% end %>

  <% if @inactive_neighborhoods.present? %>
    <section class="mt-5" aria-labelledby="inactive-heading">
      <h2 id="inactive-heading" class="h5 text-muted mb-3">Inactive neighborhoods</h2>
      <ul class="list-inline mb-0">
        <% @inactive_neighborhoods.each do |neighborhood| %>
          <li class="list-inline-item mb-2">
            <%= link_to "#{neighborhood.name}, #{neighborhood.city}", neighborhood_path(neighborhood),
                  class: "btn btn-sm btn-outline-secondary" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
