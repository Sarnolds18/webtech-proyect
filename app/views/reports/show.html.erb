<% content_for :title, "Report on #{@report.listing.title} - Roomies" %>
<% listing = @report.listing %>

<div class="container py-4">
  <p class="mb-2">
    <%= link_to reports_path do %>
      <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to the reports
    <% end %>
  </p>
  <h1 class="fw-bold mb-2">Report on <%= listing.title %></h1>
  <p class="d-flex flex-wrap align-items-center gap-2 text-muted mb-4">
    <%= status_badge(@report.status) %>
    <span>Sent by <%= @report.reporter.name %> on <%= long_date(@report.created_at) %></span>
  </p>

  <div class="row g-4 g-lg-5">
    <div class="col-lg-8">
      <section class="mb-4" aria-labelledby="reason-heading">
        <h2 id="reason-heading" class="h4 fw-bold"><%= @report.reason.humanize %></h2>
        <% if @report.details.present? %>
          <%= simple_format @report.details %>
        <% else %>
          <p class="text-muted">The member did not add details.</p>
        <% end %>
      </section>

      <% if @report.resolvable? && policy(@report).dismiss? %>
        <section class="card shadow-sm mb-4" aria-labelledby="decision-heading">
          <div class="card-body p-4">
            <h2 id="decision-heading" class="h5 fw-bold mb-3">Your decision</h2>
            <%= form_with scope: :moderation, url: dismiss_report_path(@report), method: :patch do |form| %>
              <div class="mb-3">
                <%= form.label :notes, "Notes for the log (optional)", class: "form-label" %>
                <%= form.text_area :notes, class: "form-control", rows: 2 %>
              </div>
              <div class="d-flex flex-wrap gap-2">
                <%= form.submit "Dismiss the report", class: "btn btn-outline-secondary" %>
                <%= form.submit "Withdraw the listing", class: "btn btn-danger",
                      formaction: take_action_report_path(@report),
                      data: { turbo_confirm: "Withdraw #{listing.title}? Its applications still waiting will be rejected." } %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <section aria-labelledby="log-heading">
        <h2 id="log-heading" class="h5 fw-bold">Moderation log</h2>
        <% if @actions.present? %>
          <ul class="list-group list-group-flush">
            <% @actions.each do |action| %>
              <li class="list-group-item px-0">
                <strong><%= action.action_type.humanize %></strong> by <%= action.moderator.name %>,
                <%= long_date(action.created_at) %>
                <% if action.notes.present? %><span class="d-block small text-muted"><%= action.notes %></span><% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted mb-0">No moderator has acted on this report yet.</p>
        <% end %>
      </section>
    </div>

    <div class="col-lg-4">
      <h2 class="h5 fw-bold mb-3">The listing</h2>
      <p class="small text-muted">Hosted by <%= listing.host.name %> · <%= status_badge(listing.status) %></p>
      <div class="row row-cols-1">
        <%= render "listings/listing_card", listing: listing %>
      </div>
    </div>
  </div>
</div>
