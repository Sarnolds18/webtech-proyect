<%# The one place where the markup of a property card lives. Render it inside a Bootstrap row. %>
<div class="col">
  <article class="card h-100 shadow-sm">
    <div class="card-body d-flex flex-column p-4">
      <p class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill px-3 py-2 fw-semibold">
          <%= property.neighborhood.name %>
        </span>
        <span class="small text-muted"><%= property.property_type.humanize %></span>
      </p>

      <h3 class="card-title h5 fw-bold mb-1">
        <%= link_to property.title, property_path(property), class: "stretched-link text-decoration-none text-dark" %>
      </h3>
      <p class="card-text text-secondary small flex-grow-1">
        <%= pluralize(property.bedrooms, "bedroom") %> · <%= pluralize(property.bathrooms, "bathroom") %>
      </p>

      <p class="pt-3 border-top mt-auto mb-0 small text-muted d-flex justify-content-between gap-2">
        <span><i class="bi bi-door-open me-1 text-primary" aria-hidden="true"></i><%= pluralize(property.listings.size, "listing") %></span>
        <span>Hosted by <strong><%= property.host.name %></strong></span>
      </p>
    </div>
  </article>
</div>
