<% content_for :title, "Reset password - Roomies" %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h1 class="h3 fw-bold mb-3">Forgot your password?</h1>
          <p class="text-muted mb-4">Enter your email address and we will send you a link to reset your password.</p>

          <%= form_with url: passwords_path do |form| %>
            <div class="mb-4">
              <%= form.label :email_address, "Email address", class: "form-label" %>
              <%= form.email_field :email_address, class: "form-control", required: true, autofocus: true,
                    autocomplete: "email", value: params[:email_address] %>
            </div>
            <%= form.submit "Email reset instructions", class: "btn btn-primary w-100" %>
          <% end %>

          <p class="small mt-3 mb-0"><%= link_to "Back to log in", new_session_path %></p>
        </div>
      </div>
    </div>
  </div>
</div>
