<% content_for :title, "Saved listings - Roomies" %>

<div class="container py-4">
  <h1 class="fw-bold mb-1">Saved listings</h1>
  <p class="text-muted mb-4">
    The rooms you bookmarked. A listing that stops being published stays here with its new status.
  </p>

  <div id="saved_listings" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% if @saved_listings.any? %>
      <% @saved_listings.each do |saved_listing| %>
        <% listing = saved_listing.listing %>
        <%= render "listings/listing_card", listing: listing, id: dom_id(listing, :saved_card),
                   footer: render("saved_listings/button", listing: listing, saved: true) %>
      <% end %>
    <% else %>
      <%= render "saved_listings/empty" %>
    <% end %>
  </div>
</div>
