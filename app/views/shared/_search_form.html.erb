<%# Search fields shared by the home page and the listings index. They keep the values of the current search. %>
<%= form_with url: listings_path, method: :get, class: "row g-3 align-items-end" do |form| %>
  <div class="col-md-4">
    <%= form.label :neighborhood_id, "Neighborhood", class: "form-label" %>
    <%= form.select :neighborhood_id,
          options_from_collection_for_select(neighborhoods, :id, :name, params[:neighborhood_id]),
          { include_blank: "Any neighborhood" }, class: "form-select" %>
  </div>

  <div class="col-md-4">
    <%= form.label :max_rent, "Maximum rent", class: "form-label" %>
    <%= form.number_field :max_rent, value: params[:max_rent], min: 0,
          placeholder: "e.g. 350000", class: "form-control" %>
  </div>

  <div class="col-md-4">
    <%= form.label :available_from, "Available by", class: "form-label" %>
    <%= form.date_field :available_from, value: params[:available_from], class: "form-control" %>
  </div>

  <% if local_assigns[:amenities].present? %>
    <% selected_amenity_ids = Array.wrap(params[:amenity_ids]).grep(String) %>
    <div class="col-12">
      <details class="amenity-filter" <%= "open" if selected_amenity_ids.compact_blank.any? %>>
        <summary class="form-label mb-2">
          Amenities
          <% if selected_amenity_ids.compact_blank.any? %>
            <span class="badge text-bg-primary ms-1"><%= selected_amenity_ids.compact_blank.size %> selected</span>
          <% end %>
        </summary>
        <fieldset>
          <legend class="visually-hidden">Amenities the property must have</legend>
          <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-2">
            <% amenities.each do |amenity| %>
              <div class="col">
                <div class="form-check">
                  <%= check_box_tag "amenity_ids[]", amenity.id, selected_amenity_ids.include?(amenity.id.to_s),
                        id: "amenity_#{amenity.id}", class: "form-check-input" %>
                  <%= label_tag "amenity_#{amenity.id}", class: "form-check-label" do %>
                    <i class="bi <%= amenity.icon %> me-1" aria-hidden="true"></i><%= amenity.name %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
          <p class="form-text mb-0">Rooms whose property has every amenity you check.</p>
        </fieldset>
      </details>
    </div>
  <% end %>

  <div class="col-12">
    <%= form.submit "Search rooms", name: nil, class: "btn btn-primary" %>
  </div>
<% end %>
