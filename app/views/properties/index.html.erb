<% content_for :title, "Properties - Roomies" %>

<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="fw-bold mb-0">Properties</h1>
    <%# Visitors see it too: it takes them to sign in first, then to the form. %>
    <% if current_user.nil? || policy(Property).create? %>
      <%= link_to new_property_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New property
      <% end %>
    <% end %>
  </div>

  <h2 class="h5 text-muted mb-3"><%= pluralize(@properties.length, "property") %></h2>

  <% if @properties.present? %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <%= render partial: "properties/property_card", collection: @properties, as: :property %>
    </div>
  <% else %>
    <p class="mb-0">There are no properties registered yet.</p>
  <% end %>
</div>
