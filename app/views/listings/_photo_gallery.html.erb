<%# Every photograph of a listing, in a Bootstrap carousel (arrows only when there is more than one). %>
<% photos = listing.photos %>
<% if photos.attached? %>
  <div id="listing-photos" class="carousel slide mb-4" aria-label="Photographs of the room">
    <div class="carousel-inner rounded-3">
      <% photos.each_with_index do |photo, index| %>
        <div class="carousel-item <%= "active" if index.zero? %>">
          <div class="ratio ratio-16x9">
            <%= image_tag photo.variant(:large), class: "object-fit-cover",
                  alt: "#{alt}, photograph #{index + 1} of #{photos.size}", loading: (index.zero? ? "eager" : "lazy") %>
          </div>
        </div>
      <% end %>
    </div>

    <% if photos.size > 1 %>
      <button class="carousel-control-prev" type="button" data-bs-target="#listing-photos" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous photograph</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#listing-photos" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next photograph</span>
      </button>
    <% end %>
  </div>
<% else %>
  <div class="ratio ratio-16x9 mb-4">
    <%= listing_cover_photo(listing, css: "rounded-3", alt: alt) %>
  </div>
<% end %>
