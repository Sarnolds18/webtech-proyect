<% content_for :title, "Edit profile - Roomies" %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <h1 class="fw-bold mb-4">Edit profile</h1>

      <%= form_with model: @user, url: profile_path, method: :patch do |form| %>
        <%= render "shared/form_errors", record: @user %>

        <div class="mb-3">
          <%= form.label :name, class: "form-label" %>
          <%= form.text_field :name, class: "form-control", required: true, autocomplete: "name" %>
          <%= field_error @user, :name %>
        </div>
        <div class="mb-3">
          <%= form.label :email_address, "Email address", class: "form-label" %>
          <%= form.email_field :email_address, class: "form-control", required: true, autocomplete: "email" %>
          <%= field_error @user, :email_address %>
        </div>
        <div class="mb-3">
          <%= form.label :phone, class: "form-label" %>
          <%= form.telephone_field :phone, class: "form-control", autocomplete: "tel", placeholder: "+56 9 5550 3001" %>
          <%= field_error @user, :phone %>
        </div>
        <div class="mb-4">
          <%= form.label :bio, "Short bio", class: "form-label" %>
          <%= form.text_area :bio, class: "form-control", rows: 4, maxlength: 500,
                aria: { describedby: "bio_help" } %>
          <div id="bio_help" class="form-text">Tell us about yourself in up to 500 characters.</div>
          <%= field_error @user, :bio %>
        </div>

        <fieldset class="border rounded p-3 mb-4">
          <legend class="float-none w-auto px-2 fs-6 fw-bold">Change password (optional)</legend>
          <p class="small text-muted">Leave the new password blank to keep your current password.</p>
          <div class="mb-3">
            <%= form.label :password_challenge, "Current password", class: "form-label" %>
            <%= form.password_field :password_challenge, class: "form-control", autocomplete: "current-password" %>
            <%= field_error @user, :password_challenge %>
          </div>
          <div class="mb-3">
            <%= form.label :password, "New password", class: "form-label" %>
            <%= form.password_field :password, class: "form-control", autocomplete: "new-password", minlength: 8 %>
            <%= field_error @user, :password %>
          </div>
          <div>
            <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
            <%= form.password_field :password_confirmation, class: "form-control", autocomplete: "new-password", minlength: 8 %>
            <%= field_error @user, :password_confirmation %>
          </div>
        </fieldset>

        <div class="d-flex gap-2">
          <%= form.submit "Save changes", class: "btn btn-primary" %>
          <%= link_to "Cancel", profile_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
